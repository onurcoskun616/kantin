# Topkapi Kantin Yonetim Sistemi - systemd servis birimi
#
# Kurulum:
#   sudo cp deploy/kantin.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kantin

[Unit]
Description=Topkapi Okullari Kantin Yonetim Sistemi
Documentation=https://github.com/onurcoskun616/kantin
After=network-online.target
Wants=network-online.target

# Surekli cokerse sonsuz donguye girmesin (systemd 230+ bu anahtarlari
# [Unit] bolumunde bekler; [Service] icinde yazilirsa sessizce yok sayilir)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kantin
Group=kantin
WorkingDirectory=/opt/kantin
ExecStart=/usr/bin/node server/index.js
EnvironmentFile=/opt/kantin/.env
Environment=NODE_ENV=production

Restart=always
RestartSec=5

# Gunlukler journald'a yazilir: journalctl -u kantin -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kantin

# Guvenlik siniflandirmasi - servis yalnizca kendi dizinine yazabilir
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Bastaki '-' dizin henuz yoksa servisin baslamamasini onler.
# (data/ekler fatura dosyalari icin; data'nin altinda oldugundan kapsanir)
ReadWritePaths=-/opt/kantin/data
ReadWritePaths=-/opt/kantin/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
