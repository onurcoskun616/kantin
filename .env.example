# Topkapi Kantin Yonetim Sistemi - ayar dosyasi
#
# ONEMLI: Bu dosyada SATIR ICI YORUM KULLANMAYIN.
#   Yanlis:  HOST=127.0.0.1   # nginx arkasinda
#   Dogru:   # nginx arkasinda
#            HOST=127.0.0.1
# Hem systemd hem uygulama, '#' sonrasini degerin PARCASI sayar ve sunucu
# baslamaz. Aciklamayi her zaman kendi satirina yazin.

# Sunucu
PORT=3000

# Gelistirmede 0.0.0.0, sunucuda 127.0.0.1 olmali:
# uygulama dogrudan internete acilmasin, nginx onunde dursun.
HOST=0.0.0.0

# Veritabani dosyasi
DB_PATH=./data/kantin.db

# Faturalarin PDF / foto / e-Fatura XML dosyalari.
# Veritabaninin ICINDE DEGILDIR; yedeklerken bu dizini de alin.
ATTACHMENTS_DIR=./data/ekler

# Oturum imzalama anahtari - PRODUCTION'DA MUTLAKA DEGISTIRIN
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=degistirin-bu-degeri-uzun-ve-rastgele-olmali

# Oturum suresi (saat)
SESSION_TTL_HOURS=12

# Ilk kurulumda olusturulacak yonetici hesabi
ADMIN_EMAIL=admin@topkapiokullari.com
ADMIN_PASSWORD=Kantin2026!
ADMIN_NAME=Sistem Yoneticisi
